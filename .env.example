# Docker Compose local development settings.
# Copy to .env and use URL-safe passwords (letters, digits, hyphens).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=slack_db
POSTGRES_PORT=5432

# Optional public origin for local development.
FRONTEND_URL=http://localhost:3000

# Local object-store credentials. Change for shared or hosted environments.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
