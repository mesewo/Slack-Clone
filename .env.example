# Copy this file to .env for local development.
# Never commit real passwords, tokens, or API keys.

# Docker Compose / PostgreSQL
postgrespassword=change-me

# Go API
DATABASE_URL=postgres://postgres:change-me@localhost:5432/slack_db?sslmode=disable
JWT_SECRET=replace-with-a-random-secret
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Next.js web app -> Go API
GO_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Optional: Clerk is not required for the current Go-auth flow.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Optional: Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ORG=
# NEXT_PUBLIC_SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=