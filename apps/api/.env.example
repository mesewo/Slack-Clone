# Go API local environment
# Run the core and gateway processes from apps/api.

DATABASE_URL=postgres://postgres:change-me@localhost:5432/slack_db?sslmode=disable
JWT_SECRET=replace-with-a-random-secret

GATEWAY_GRPC_ADDR=localhost:9090
CORE_GRPC_ADDR=localhost:9091
KAFKA_BROKER_ADDR=localhost:19092
REDIS_ADDR=localhost:6379
ELASTICSEARCH_URL=http://127.0.0.1:9200
UPLOAD_DIR=./data/uploads
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=slack-uploads
S3_USE_SSL=false

APP_ENV=development
FRONTEND_URL=http://localhost:3000
