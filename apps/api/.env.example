# Go API local environment.
# Compose reads JWT_SECRET from this file; Compose supplies container addresses.
# For local Go processes, this file configures the host service addresses below.

DATABASE_URL=postgres://postgres:local-dev-password@localhost:5432/slack_db?sslmode=disable
JWT_SECRET=local-development-only-change-before-sharing

GATEWAY_GRPC_ADDR=localhost:9090
CORE_GRPC_ADDR=localhost:9091
KAFKA_BROKER_ADDR=localhost:19092
REDIS_ADDR=localhost:6379
ELASTICSEARCH_URL=http://127.0.0.1:9200
UPLOAD_DIR=./data/uploads
S3_ENDPOINT=127.0.0.1:9000
# Optional browser-reachable endpoint used only to sign direct upload URLs.
S3_PUBLIC_ENDPOINT=127.0.0.1:9000
S3_PUBLIC_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=slack-uploads
S3_USE_SSL=false

APP_ENV=development
FRONTEND_URL=http://localhost:3000
